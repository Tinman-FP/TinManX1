# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "TinManX1")
set(SLIC3R_APP_KEY "OrcaSlicer")
set(TINMANX1_REVISION "v2026.08.12-bambu-lan-runtime.1")
set(TINMANX1_PACKAGE_VERSION "2026.8.12.1")

if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
set(SoftFever_VERSION "2.4.2")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       SoftFever_VERSION_MATCH ${SoftFever_VERSION})
set(ORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(ORCA_VERSION_PATCH ${CMAKE_MATCH_3})

string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)\\.([0-9]+)$"
       TINMANX1_PACKAGE_VERSION_MATCH ${TINMANX1_PACKAGE_VERSION})
if(NOT TINMANX1_PACKAGE_VERSION_MATCH STREQUAL TINMANX1_PACKAGE_VERSION)
    message(FATAL_ERROR "TINMANX1_PACKAGE_VERSION must contain four numeric components")
endif()
set(TINMANX1_PACKAGE_VERSION_MAJOR ${CMAKE_MATCH_1})
set(TINMANX1_PACKAGE_VERSION_MINOR ${CMAKE_MATCH_2})
set(TINMANX1_PACKAGE_VERSION_PATCH ${CMAKE_MATCH_3})
set(TINMANX1_PACKAGE_VERSION_REVISION ${CMAKE_MATCH_4})
string(REPLACE "." "," TINMANX1_PACKAGE_VERSION_RESOURCE ${TINMANX1_PACKAGE_VERSION})

set(SLIC3R_VERSION "02.06.00.51")

if (NOT DEFINED ORCA_UPDATER_SIG_KEY)
    set(ORCA_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
