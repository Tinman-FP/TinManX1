diff --git a/test_reference_schema_fallback.py b/test_reference_schema_fallback.py
new file mode 100644
index 0000000..4dfc869
--- /dev/null
+++ b/test_reference_schema_fallback.py
@@ -0,0 +1,17 @@
+import settings_compare as sc
+import surface
+
+
+def test_reference_schema_fallback_does_not_expand_cli_surface(monkeypatch):
+    monkeypatch.setattr(surface, "type_map", lambda: {"filament_mixed_components": "coString"})
+    assert sc.decode_gcode_value("filament_mixed_components", '""') == '""'
+    monkeypatch.setattr(surface, "type_map", lambda: {})
+    assert sc.decode_gcode_value("filament_mixed_components", '""') == [""]
+    assert "filament_mixed_components" not in surface.type_map()
+    assert sc.type_of("unknown_future_setting") is None
+
+
+def test_reference_vector_values_are_still_compared(monkeypatch):
+    monkeypatch.setattr(surface, "type_map", lambda: {})
+    assert sc.decode_gcode_value("filament_mixed_components", '"first;part";second') == ["first;part", "second"]
+    assert not sc.values_match("filament_mixed_components", ["first"], ["second"])
